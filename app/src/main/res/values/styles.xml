<resources>

    <style name="AppTheme" parent="AppBaseTheme" />

    <style name="AppTheme.NoActionBar" parent="AppBaseTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.Settings" parent="AppTheme.NoActionBar">
        <item name="preferenceTheme">@style/ThemeOverlay.App.Preference</item>
    </style>

    <!-- ponytail: M3 Expressive light -->
    <style name="AppBaseTheme" parent="Theme.Material3Expressive.DynamicColors.Light">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/M3.ActivityAnimation</item>
        <item name="floatingActionButtonStyle">@style/Widget.App.FloatingActionButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.AlertDialog</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="preferenceTheme">@style/ThemeOverlay.App.Preference</item>
    </style>

    <style name="M3.ActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <style name="AppIntroLayoutStyle">
        <item name="android:paddingTop">@dimen/appintro_statusbar_height</item>
        <item name="android:paddingBottom">@dimen/appintro2_bottombar_height</item>
    </style>

    <style name="AppIntroDefaultHeading" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/appintro_headtext_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">@dimen/appintro_head_padding</item>
        <item name="android:gravity">bottom|center_horizontal</item>
    </style>

    <style name="AppIntroDefaultText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/appintro_desctext_size</item>
        <item name="android:padding">@dimen/appintro_desc_padding</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppIntroIconText" parent="AppIntroDefaultText">
        <item name="android:gravity">start</item>
        <item name="android:drawablePadding">30dp</item>
    </style>

    <style name="AppIntroInfoText" parent="AppIntroIconText">
        <item name="drawableStartCompat">@drawable/ic_info_vector</item>
    </style>

    <style name="AppIntroWarningText" parent="AppIntroIconText">
        <item name="android:textSize">@dimen/big_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_warning</item>
        <item name="drawableStartCompat">@drawable/ic_error_outline_vector</item>
    </style>

    <style name="AppIntroDangerText" parent="AppIntroIconText">
        <item name="android:textSize">@dimen/big_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_error</item>
        <item name="drawableStartCompat">@drawable/ic_warning_vector</item>
    </style>

</resources>
