<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trash_holder"
    style="@style/Widget.App.ListCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/m3_spacing_md"
    android:layout_marginVertical="@dimen/m3_spacing_xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/m3_spacing_md">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trash_name"
            style="@style/M3.ListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="document.pdf" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trash_origin"
            style="@style/M3.ListItemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/m3_spacing_xs"
            tools:text="/storage/emulated/0/Download" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trash_date"
            style="@style/M3.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/m3_spacing_xs"
            tools:text="2026-06-29" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
