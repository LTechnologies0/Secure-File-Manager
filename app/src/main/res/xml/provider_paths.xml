<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Required for PGP Shield IPC: share files from external storage via content:// URIs -->
    <external-path
        name="external_files"
        path="." />
    <!-- Never expose vault ciphertext (.hidden/) via FileProvider — stage plaintext to share/ first. -->
    <cache-path
        name="share"
        path="share/" />
    <cache-path
        name="hidden_view"
        path="hidden-view/" />
    <cache-path
        name="media"
        path="media/" />
    <cache-path
        name="remote"
        path="remote/" />
    <cache-path
        name="incoming"
        path="incoming/" />
</paths>
